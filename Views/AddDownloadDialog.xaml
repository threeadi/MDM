<Window x:Class="Mdm.Views.AddDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:Mdm.Services"
        Title="{services:Loc addDownload.title}"
        Icon="pack://application:,,,/Mdm;component/Assets/app.ico"
        Width="540" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource CanvasBrush}">

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource SurfaceLowBrush}" CornerRadius="8" Margin="12" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Text="{services:Loc addDownload.heading}" 
                       FontSize="16" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimaryBrush}" 
                       Margin="0,0,0,12"/>

            <!-- Form Inputs -->
            <StackPanel Grid.Row="1" VerticalAlignment="Top">
                <TextBlock Text="{services:Loc addDownload.urlLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="UrlTextBox" Style="{StaticResource FlatTextBox}" Margin="0,0,0,4" TextChanged="UrlTextBox_TextChanged"/>

                <!-- Probe Info Badge -->
                <Border x:Name="ProbeBadge" Background="#1D2432" BorderBrush="#2F3B52" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock x:Name="ProbeStatusText" Text="Memeriksa URL..." FontSize="11" Foreground="{StaticResource AccentCyanBrush}"/>
                </Border>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{services:Loc addDownload.saveDirLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="SaveDirTextBox" Style="{StaticResource FlatTextBox}"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="..." Style="{StaticResource FlatActionButton}" Width="32" Height="28" VerticalAlignment="Bottom" Margin="6,0,10,0" Click="BrowseFolder_Click"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{services:Loc addDownload.connectionsLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="ThreadsTextBox" Text="16" Style="{StaticResource FlatTextBox}"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{services:Loc addDownload.filenameLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="FilenameTextBox" Style="{StaticResource FlatTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{services:Loc addDownload.categoryLabel}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CategoryComboBox" Height="28" Background="#171C24" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="#2E3340">
                            <ComboBoxItem Content="Umum" IsSelected="True"/>
                            <ComboBoxItem Content="Kompresi"/>
                            <ComboBoxItem Content="Dokumen"/>
                            <ComboBoxItem Content="Video"/>
                            <ComboBoxItem Content="Musik"/>
                            <ComboBoxItem Content="Program"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="StartNowCheckBox" Content="{services:Loc addDownload.startDownload}" IsChecked="True" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="{services:Loc common.cancel}" Style="{StaticResource FlatActionButton}" Width="80" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="{services:Loc addDownload.startDownload}" Style="{StaticResource PrimaryCyanButton}" Width="130" Click="StartDownload_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
