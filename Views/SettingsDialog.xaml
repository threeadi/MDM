<Window x:Class="Mdm.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Mdm.Controls"
        xmlns:services="clr-namespace:Mdm.Services"
        Title="{services:Loc settings.title}"
        Icon="pack://application:,,,/Mdm;component/Assets/app.ico"
        Width="890" Height="650"
        MinWidth="780" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Mdm;component/Styles/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Acrylic Matte Dark Shell Container (Google Stitch Project 8619236184062954585 1:1) -->
    <Border Background="{StaticResource SurfaceLowBrush}" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1" 
            CornerRadius="12" 
            Margin="6"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- 0: Frameless Window Header / TitleBar -->
                <RowDefinition Height="42"/>
                <!-- 1: Subheader with Sliders & Version Badge -->
                <RowDefinition Height="Auto"/>
                <!-- 2: 7-Tab Bar Navigation -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Scrollable Tab Content Viewport -->
                <RowDefinition Height="*"/>
                <!-- 4: Footer Action Bar -->
                <RowDefinition Height="54"/>
            </Grid.RowDefinitions>

            <!-- 0: Frameless Title Bar (Stitch Surface Base #0A0D14) -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Brand / Logo (MDM Official Cloud Logo) -->
                        <Image Source="pack://application:,,,/Mdm;component/Assets/app.png" 
                               Width="20" Height="20" 
                               RenderOptions.BitmapScalingMode="HighQuality" 
                               Margin="0,0,8,0" 
                               VerticalAlignment="Center"/>
                        <TextBlock Text="MDM" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="—" FontSize="12" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{services:Loc settings.title}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window System Controls (Minimize, Maximize, Close strictly at top right) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize -->
                        <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Minimize_Click" Margin="0,0,2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <controls:LucideIcon x:Name="ic" Kind="minus" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="ic" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Maximize -->
                        <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Maximize_Click" Margin="0,0,2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <controls:LucideIcon x:Name="ic" Kind="square" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter TargetName="ic" Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close -->
                        <Button Width="28" Height="28" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Close_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                        <controls:LucideIcon x:Name="ic" Kind="x" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#DC2626"/>
                                            <Setter TargetName="ic" Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1: Subheader Banner (Stitch Clean Dark 1:1) -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceLowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Sliders Icon + Title -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,14,0">
                            <controls:LucideIcon Kind="sliders" Width="18" Height="18" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{services:Loc settings.heading}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{services:Loc settings.subtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>


                </Grid>
            </Border>

            <!-- 2: 7-Tab Bar Navigation (Stitch Clean Dark 1:1) -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0,20,0">
                <StackPanel Orientation="Horizontal">
                    <!-- Tab 1: Umum -->
                    <RadioButton x:Name="TabRadioGeneral" GroupName="SettingsTabs" Style="{StaticResource SettingsTabRadioStyle}" IsChecked="True" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="monitor" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Margin="0,0,7,0"/>
                            <TextBlock Text="{services:Loc settings.tabGeneral}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 2: Koneksi -->
                    <RadioButton x:Name="TabRadioConnection" GroupName="SettingsTabs" Style="{StaticResource SettingsTabRadioStyle}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="zap" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Margin="0,0,7,0"/>
                            <TextBlock Text="{services:Loc settings.tabConnection}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 3: Tipe Berkas -->
                    <RadioButton x:Name="TabRadioFileTypes" GroupName="SettingsTabs" Style="{StaticResource SettingsTabRadioStyle}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="file-text" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Margin="0,0,7,0"/>
                            <TextBlock Text="{services:Loc settings.tabFileTypes}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 4: Lokasi Simpan -->
                    <RadioButton x:Name="TabRadioSaveTo" GroupName="SettingsTabs" Style="{StaticResource SettingsTabRadioStyle}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="folder" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Margin="0,0,7,0"/>
                            <TextBlock Text="{services:Loc settings.tabSavePath}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 5: Ekstensi -->
                    <RadioButton x:Name="TabRadioExtensions" GroupName="SettingsTabs" Style="{StaticResource SettingsTabRadioStyle}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="globe" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Margin="0,0,7,0"/>
                            <TextBlock Text="{services:Loc settings.tabExtensions}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 6: Telegram -->
                    <RadioButton x:Name="TabRadioTelegram" GroupName="SettingsTabs" Style="{StaticResource SettingsTabRadioStyle}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="send" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Margin="0,0,7,0"/>
                            <TextBlock Text="{services:Loc settings.tabTelegram}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <!-- Tab 7: Proxy & SOCKS -->
                    <RadioButton x:Name="TabRadioProxy" GroupName="SettingsTabs" Style="{StaticResource SettingsTabRadioStyle}" Checked="Tab_Checked">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="shield-check" Width="14" Height="14" Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}" Margin="0,0,7,0"/>
                            <TextBlock Text="{services:Loc settings.tabProxy}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <!-- 3: Scrollable Tab Content Viewport -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Background="{StaticResource SurfaceLowBrush}" Padding="24,20">
                <StackPanel>
                    <!-- Success Notification Banner -->
                    <Border x:Name="SuccessBanner" Background="#1A2563EB" BorderBrush="#4D2563EB" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="check" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="SuccessBannerText" Text="{services:Loc settings.saveSuccess}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- ======================================================== -->
                    <!-- TAB 1: UMUM (GENERAL) - STITCH 1:1                       -->
                    <!-- ======================================================== -->
                    <Grid x:Name="PanelGeneral" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Column: Bahasa + Integrasi Sistem & Startup -->
                        <StackPanel Grid.Column="0">
                            <!-- Card 0: Pilihan Bahasa -->
                            <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Kind="globe" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{services:Loc settings.langTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{services:Loc settings.langDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                                    <ComboBox x:Name="LanguageComboBox" Style="{StaticResource DarkComboBox}">
                                        <ComboBoxItem Content="🇮🇩 Bahasa Indonesia (Indonesian)" IsSelected="True"/>
                                        <ComboBoxItem Content="🇺🇸 English (US / International)"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <!-- Card 1: Integrasi Sistem & Startup -->
                            <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Kind="monitor" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{services:Loc settings.sysIntegration}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Auto Start -->
                                    <CheckBox x:Name="AutoStartCheckBox" Style="{StaticResource DarkCheckBox}" Margin="0,0,0,10">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{services:Loc settings.autoStart}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{services:Loc settings.autoStartDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Media Panel Overlay -->
                                    <CheckBox x:Name="MediaPanelCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,10">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{services:Loc settings.mediaPanel}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{services:Loc settings.mediaPanelDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Clipboard Auto Capture -->
                                    <CheckBox x:Name="ClipboardCaptureCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,10">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{services:Loc settings.clipboardCapture}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{services:Loc settings.clipboardCaptureDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Notify on Complete -->
                                    <CheckBox x:Name="NotifyOnCompleteCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,10">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{services:Loc settings.notifyComplete}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{services:Loc settings.notifyCompleteDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Minimize to Tray -->
                                    <CheckBox x:Name="MinimizeToTrayCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True" Margin="0,0,0,10">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{services:Loc settings.minimizeToTray}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{services:Loc settings.minimizeToTrayDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <!-- Show Completion Dialog -->
                                    <CheckBox x:Name="ShowCompletionDialogCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{services:Loc settings.showCompletionDialog}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{services:Loc settings.showCompletionDialogDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Right Column: Kunci Tombol Cepat + Telemetry Overview -->
                        <StackPanel Grid.Column="2">
                            <!-- Card: Kunci Tombol Cepat (Hotkeys) -->
                            <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                                <StackPanel>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Kind="layers" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{services:Loc settings.hotkeysTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock Text="{services:Loc settings.hotkeyPrevent}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Border HorizontalAlignment="Right" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                                <TextBlock Text="Alt" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid>
                                            <TextBlock Text="{services:Loc settings.hotkeyForce}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            <Border HorizontalAlignment="Right" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,3">
                                                <TextBlock Text="Insert" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Card: Stitch Kinetic Telemetry Note -->
                            <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <controls:LucideIcon Kind="flame" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="KINETIC TELEMETRY ENGINE" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Pengaturan preferensi di atas akan disinkronkan langsung secara persisten ke database internal MDM Turbo. Setiap perubahan pada mode unduhan langsung aktif tanpa perlu memuat ulang aplikasi." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" LineHeight="17" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- ======================================================== -->
                    <!-- TAB 2: SAMBUNGAN (CONNECTION) - STITCH 1:1               -->
                    <!-- ======================================================== -->
                    <StackPanel x:Name="PanelConnection" Visibility="Collapsed">
                        <!-- Card 1: Batas Kecepatan (Bandwidth Limiter) -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <controls:LucideIcon Kind="zap" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="BATAS KECEPATAN (BANDWIDTH LIMITER)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <CheckBox x:Name="EnableLimitCheckBox" Style="{StaticResource DarkCheckBox}" Checked="EnableLimit_Checked" Unchecked="EnableLimit_Unchecked" Margin="0,0,0,14">
                                    <StackPanel Margin="8,0,0,0">
                                        <TextBlock Text="{services:Loc settings.enableGlobalLimit}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{services:Loc settings.enableGlobalLimitDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>

                                <StackPanel x:Name="SpeedLimitGrid" Orientation="Horizontal" Margin="28,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{services:Loc settings.maxSpeedLabel}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBox x:Name="GlobalLimitValueTextBox" Text="122" Width="96" Height="32" Style="{StaticResource FlatTextBox}" TextAlignment="Center" VerticalContentAlignment="Center"/>
                                    <ComboBox x:Name="GlobalLimitUnitComboBox" Width="76" Height="32" Style="{StaticResource DarkComboBox}" Margin="8,0,0,0">
                                        <ComboBoxItem Content="KB/s" IsSelected="True"/>
                                        <ComboBoxItem Content="MB/s"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Batas Waktu & Percobaan Jaringan -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <controls:LucideIcon Kind="clock" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="BATAS WAKTU &amp; PERCOBAAN JARINGAN" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Timeout -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{services:Loc settings.connTimeoutLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="ConnectionTimeoutTextBox" Text="30" Height="32" Style="{StaticResource FlatTextBox}" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="{services:Loc settings.connTimeoutDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>

                                    <!-- Right: Max Retries -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{services:Loc settings.maxRetriesLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="MaxRetriesTextBox" Text="10" Height="32" Style="{StaticResource FlatTextBox}" VerticalContentAlignment="Center" Margin="0,0,0,6"/>
                                        <TextBlock Text="{services:Loc settings.maxRetriesDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- TAB 3: TIPE BERKAS (FILE TYPES) - STITCH 1:1             -->
                    <!-- ======================================================== -->
                    <StackPanel x:Name="PanelFileTypes" Visibility="Collapsed">
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <controls:LucideIcon Kind="file-text" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc settings.fileTypesTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{services:Loc settings.fileTypesDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                <TextBox x:Name="AutoCaptureExtensionsTextBox" 
                                         Height="90" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto" 
                                         Style="{StaticResource FlatTextBox}" 
                                         Foreground="{StaticResource AccentCyanBrush}"
                                         Margin="0,0,0,8"/>

                                <TextBlock Text="{services:Loc settings.fileTypesHint}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <controls:LucideIcon Kind="shield-check" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc settings.excludedSitesTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{services:Loc settings.excludedSitesDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

                                <TextBox x:Name="ExcludedSitesTextBox" 
                                         Height="75" 
                                         TextWrapping="Wrap" 
                                         AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto" 
                                         Style="{StaticResource FlatTextBox}" 
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         Margin="0,0,0,8"/>

                                <TextBlock Text="{services:Loc settings.excludedSitesHint}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- TAB 4: LOKASI SIMPAN (SAVE TO) - STITCH 1:1              -->
                    <!-- ======================================================== -->
                    <StackPanel x:Name="PanelSaveTo" Visibility="Collapsed">
                        <!-- Primary Directory -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <controls:LucideIcon Kind="folder" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc settings.saveDirTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{services:Loc settings.defaultDirLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DefaultDownloadDirTextBox" Height="32" Style="{StaticResource FlatTextBox}" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource FlatActionButton}" Height="32" Margin="8,0,0,0" Padding="14,0" Click="BrowseDefaultDir_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="folder" Width="13" Height="13" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc common.browse}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <CheckBox x:Name="CategorySubfoldersCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{services:Loc settings.categorySubfolders}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{services:Loc settings.categorySubfoldersDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Temporary Directory -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <controls:LucideIcon Kind="hard-drive" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc settings.tempDirTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock Text="{services:Loc settings.tempDirLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TempDirTextBox" Height="32" Style="{StaticResource FlatTextBox}" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource FlatActionButton}" Height="32" Margin="8,0,0,0" Padding="14,0" Click="BrowseTempDir_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="folder" Width="13" Height="13" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc common.browse}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{services:Loc settings.tempDirDesc}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Duplicate Action -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <controls:LucideIcon Kind="copy" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{services:Loc settings.duplicateTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{services:Loc settings.duplicateDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                                <ComboBox x:Name="DuplicateActionComboBox" Style="{StaticResource DarkComboBox}" Height="32" Width="360" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="{services:Loc settings.duplicateAsk}" IsSelected="True"/>
                                    <ComboBoxItem Content="{services:Loc settings.duplicateNumber}"/>
                                    <ComboBoxItem Content="{services:Loc settings.duplicateOverwrite}"/>
                                    <ComboBoxItem Content="{services:Loc settings.duplicateResume}"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- TAB 5: EKSTENSI - STITCH 1:1                             -->
                    <!-- ======================================================== -->
                    <StackPanel x:Name="PanelExtensions" Visibility="Collapsed">
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:LucideIcon Kind="globe" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{services:Loc settings.extTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#2610B981" BorderBrush="#6610B981" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                        <TextBlock Text="{services:Loc settings.ipcActive}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="{services:Loc settings.extSubtitle}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <!-- 4 Browser Cards 2x2 Grid -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Google Chrome -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentEmeraldBrush}" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="Google Chrome" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{services:Loc settings.browserConnected}" FontSize="10" Foreground="{StaticResource AccentEmeraldBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox x:Name="BrowserChromeCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Microsoft Edge -->
                                    <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentEmeraldBrush}" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="Microsoft Edge" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{services:Loc settings.browserConnected}" FontSize="10" Foreground="{StaticResource AccentEmeraldBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox x:Name="BrowserEdgeCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Mozilla Firefox -->
                                    <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentEmeraldBrush}" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="Mozilla Firefox" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{services:Loc settings.browserInstalledActive}" FontSize="10" Foreground="{StaticResource AccentEmeraldBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox x:Name="BrowserFirefoxCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <!-- Brave Browser -->
                                    <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentEmeraldBrush}" Margin="0,0,8,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="Brave Browser" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{services:Loc settings.browserConnected}" FontSize="10" Foreground="{StaticResource AccentEmeraldBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <CheckBox x:Name="BrowserBraveCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Diagnostics Info Box -->
                                <Border Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Host Name:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="com.myownidm.host" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Windows Named Pipe:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="\\.\pipe\my_own_idm_ipc" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock Text="Localhost Fallback Port:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="127.0.0.1:18888" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentEmeraldBrush}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Register Native Host & Open Extension Folder Buttons -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource FlatActionButton}" Height="32" Padding="12,0" Click="RegisterNativeHost_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="refresh-cw" Width="12" Height="12" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc settings.reRegisterHost}" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource FlatActionButton}" Height="32" Padding="12,0" Click="OpenExtensionFolder_Click" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="folder" Width="12" Height="12" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc settings.openExtFolder}" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBlock x:Name="NativeHostFeedbackText" Text="" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Guide Card -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="{services:Loc settings.extGuideTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="{services:Loc settings.extGuideDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- TAB 6: TELEGRAM - STITCH 1:1                             -->
                    <!-- ======================================================== -->
                    <StackPanel x:Name="PanelTelegram" Visibility="Collapsed">
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="send" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{services:Loc settings.tgTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{services:Loc settings.tgSubtitle}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border x:Name="TelegramStatusBadge" Grid.Column="1" Background="#101B38" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                            <TextBlock x:Name="TelegramStatusBadgeText" Text="{services:Loc settings.tgConnectedBadge}" FontSize="10" FontWeight="Bold" Foreground="#60A5FA"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Sub-Tabs: Akun Terdaftar / Login Nomor Telepon -->
                                <Border Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,0,0,14">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SubTabTgAccounts" GroupName="TgSubTabs" Style="{StaticResource SubTabRadioStyle}" IsChecked="True" Checked="TgSubTab_Checked" Content="{services:Loc settings.tgSubTabAccounts}"/>
                                        <RadioButton x:Name="SubTabTgLogin" GroupName="TgSubTabs" Style="{StaticResource SubTabRadioStyle}" Checked="TgSubTab_Checked" Content="{services:Loc settings.tgSubTabLogin}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Sub-Tab Panel 1: Akun Terdaftar -->
                                <StackPanel x:Name="PanelTgAccountsList">
                                    <Border x:Name="ActiveAccountCard" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Width="32" Height="32" Background="#101B38" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="16" Margin="0,0,12,0">
                                                    <controls:LucideIcon Kind="user" Width="15" Height="15" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TgAccountNameText" Text="{services:Loc settings.tgActiveAccount}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="User MTProto Session (session_telegram_mdm.dat)" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#101B38" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="{services:Loc settings.tgActiveBadge}" FontSize="9.5" FontWeight="Bold" Foreground="#60A5FA"/>
                                                </Border>
                                                <Button Style="{StaticResource FlatActionButton}" Width="28" Height="28" Padding="0" Click="TgLogout_Click" ToolTip="{services:Loc settings.tgDeleteSessionTooltip}">
                                                    <controls:LucideIcon Kind="trash-2" Width="12" Height="12" Foreground="{StaticResource AccentRoseBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Empty State when no account is connected -->
                                    <Border x:Name="TgNoAccountCard" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20,16" Margin="0,0,0,8" Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center">
                                            <controls:LucideIcon Kind="shield-alert" Width="24" Height="24" Foreground="{StaticResource AccentAmberBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <TextBlock Text="{services:Loc telegram.noAccount}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentAmberBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Belum ada sesi Telegram tersimpan. Silakan beralih ke tab 'Login Akun Baru (OTP)' di atas." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Sub-Tab Panel 2: Login Nomor Telepon -->
                                <StackPanel x:Name="PanelTgLoginOtp" Visibility="Collapsed">
                                    <!-- Info notice when an account is already active -->
                                    <Border x:Name="TgActiveNoticeBorder" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:LucideIcon Kind="info" Width="16" Height="16" Foreground="{StaticResource AccentCyanBrush}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{services:Loc settings.tgAlreadyLoggedInTitle}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock x:Name="TgAlreadyLoggedInText" Text="{services:Loc settings.tgAlreadyLoggedInDesc}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Quick Launch Interactive Login Wizard -->
                                    <Button Style="{StaticResource PrimaryBlueButton}" Height="34" Margin="0,0,0,14" Click="OpenInteractiveLogin_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="send" Width="14" Height="14" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Buka Panduan Login Interaktif (Langkah demi Langkah)" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <TextBlock Text="{services:Loc settings.tgApiLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="2*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <TextBox x:Name="TgApiIdTextBox" Style="{StaticResource FlatTextBox}"/>
                                            <TextBlock Text="{services:Loc settings.tgApiIdPlaceholder}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TgApiIdTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <TextBox x:Name="TgApiHashTextBox" Style="{StaticResource FlatTextBox}"/>
                                            <TextBlock Text="{services:Loc settings.tgApiHashPlaceholder}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TgApiHashTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>

                                    <TextBlock Text="{services:Loc settings.tgPhoneLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TgPhoneTextBox" Text="+62" Style="{StaticResource FlatTextBox}" KeyDown="TgPhone_KeyDown"/>
                                        <Button x:Name="TgSendOtpBtn" Grid.Column="1" Style="{StaticResource PrimaryBlueButton}" Margin="8,0,0,0" Padding="14,4" Click="TgSendOtp_Click">
                                            <TextBlock x:Name="TgSendOtpBtnText" Text="{services:Loc settings.tgSendOtp}" Foreground="White" FontWeight="Bold"/>
                                        </Button>
                                    </Grid>

                                    <!-- OTP Input Block -->
                                    <StackPanel x:Name="TgOtpBlock" Visibility="Collapsed" Margin="0,0,0,10">
                                        <TextBlock Text="{services:Loc settings.tgEnterOtp}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="TgOtpTextBox" Style="{StaticResource FlatTextBox}" FontSize="14" HorizontalContentAlignment="Center" KeyDown="TgOtp_KeyDown"/>
                                            <Button x:Name="TgVerifyOtpBtn" Grid.Column="1" Style="{StaticResource PrimaryEmeraldButton}" Margin="8,0,0,0" Padding="12,4" Click="TgVerifyOtp_Click">
                                                <TextBlock x:Name="TgVerifyOtpBtnText" Text="{services:Loc settings.tgVerifyLogin}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- 2FA Password Block -->
                                    <StackPanel x:Name="TgPasswordBlock" Visibility="Collapsed">
                                        <TextBlock Text="{services:Loc settings.tg2faTitle}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentRoseBrush}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0">
                                                <PasswordBox x:Name="TgPasswordBox" Background="{StaticResource SurfaceLowestBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4,28,4" FontSize="12" KeyDown="TgPassword_KeyDown"/>
                                                <TextBox x:Name="TgPasswordVisibleTextBox" Style="{StaticResource FlatTextBox}" Padding="8,4,28,4" Visibility="Collapsed" KeyDown="TgPassword_KeyDown"/>
                                                <Button Style="{StaticResource FlatActionButton}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ToggleTgPassword_Click" ToolTip="{services:Loc settings.proxyPasswordTooltip}">
                                                    <controls:LucideIcon x:Name="TgEyeIcon" Kind="eye" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                            <Button x:Name="TgVerifyPasswordBtn" Grid.Column="1" Style="{StaticResource PrimaryBlueButton}" Margin="8,0,0,0" Padding="12,4" Click="TgVerifyPassword_Click">
                                                <TextBlock x:Name="TgVerifyPasswordBtnText" Text="{services:Loc settings.tg2faConfirm}" Foreground="White" FontWeight="Bold"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>

                                    <!-- Error Banner -->
                                    <Border x:Name="TgErrorBorder" Background="#26EF4444" BorderBrush="#66EF4444" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:LucideIcon Kind="alert-circle" Width="14" Height="14" Foreground="{StaticResource AccentRoseBrush}" Margin="0,1,8,0" VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1" x:Name="TgErrorText" Text="" FontSize="11" Foreground="{StaticResource AccentRoseBrush}" TextWrapping="Wrap" LineHeight="16"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Direktori Unduhan Telegram -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:LucideIcon Kind="folder" Width="14" Height="14" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{services:Loc settings.tgDirTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{services:Loc settings.tgDirLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TelegramDirTextBox" Height="32" Style="{StaticResource FlatTextBox}" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Style="{StaticResource FlatActionButton}" Height="32" Margin="8,0,0,0" Padding="14,0" Click="BrowseTelegramDir_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="folder" Width="13" Height="13" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{services:Loc common.browse}"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                    <CheckBox x:Name="TelegramSubfolderCheckBox" Style="{StaticResource DarkCheckBox}" IsChecked="True">
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="{services:Loc settings.tgSubfolder}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{services:Loc settings.tgSubfolderDesc}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ======================================================== -->
                    <!-- TAB 7: PROXY & SOCKS - STITCH 1:1                        -->
                    <!-- ======================================================== -->
                    <StackPanel x:Name="PanelProxy" Visibility="Collapsed">
                        <!-- Proxy & SOCKS Server Card -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" Background="#101B38" BorderBrush="#1E3A8A" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0">
                                                <controls:LucideIcon Kind="shield-check" Width="14" Height="14" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{services:Loc settings.proxyTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{services:Loc settings.proxySubtitle}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Enable Switch / CheckBox -->
                                        <CheckBox x:Name="ProxyEnabledCheckBox" Grid.Column="1" Style="{StaticResource DarkCheckBox}" Checked="ProxyEnabled_Checked" Unchecked="ProxyEnabled_Unchecked" VerticalAlignment="Center">
                                            <TextBlock Text="{services:Loc settings.proxyEnable}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                                        </CheckBox>
                                    </Grid>
                                </Border>

                                <!-- Proxy Config Controls -->
                                <StackPanel x:Name="ProxyConfigFields" Opacity="0.5" IsEnabled="False">
                                    <TextBlock Text="{services:Loc settings.proxyTypeLabel}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,14" MaxWidth="380" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="ProxyTypeHttpRadio" Grid.Column="0" GroupName="ProxyType" Style="{StaticResource SubTabRadioStyle}" IsChecked="True" Content="HTTP" HorizontalContentAlignment="Center"/>
                                        <RadioButton x:Name="ProxyTypeHttpsRadio" Grid.Column="2" GroupName="ProxyType" Style="{StaticResource SubTabRadioStyle}" Content="HTTPS" HorizontalContentAlignment="Center"/>
                                        <RadioButton x:Name="ProxyTypeSocks5Radio" Grid.Column="4" GroupName="ProxyType" Style="{StaticResource SubTabRadioStyle}" Content="SOCKS5 (DNS)" HorizontalContentAlignment="Center"/>
                                    </Grid>

                                    <!-- Host & Port -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{services:Loc settings.proxyHostLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                            <TextBox x:Name="ProxyHostTextBox" Text="127.0.0.1" Height="32" Style="{StaticResource FlatTextBox}" VerticalContentAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{services:Loc settings.proxyPortLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                            <TextBox x:Name="ProxyPortTextBox" Text="1080" Height="32" Style="{StaticResource FlatTextBox}" VerticalContentAlignment="Center" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Autentikasi Proxy -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{services:Loc settings.proxyAuthTitle}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{services:Loc settings.proxyAuthSubtitle}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ProxyAuthCheckBox" Grid.Column="1" Style="{StaticResource DarkCheckBox}" Checked="ProxyAuth_Checked" Unchecked="ProxyAuth_Unchecked" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Grid x:Name="ProxyAuthFields" Margin="0,8,0,0" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{services:Loc settings.proxyUserLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="ProxyUserTextBox" Height="32" Style="{StaticResource FlatTextBox}" VerticalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{services:Loc settings.proxyPassLabel}" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <PasswordBox x:Name="ProxyPasswordBox" Height="32" Background="{StaticResource SurfaceLowestBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="8,4,28,4" FontSize="12" VerticalContentAlignment="Center"/>
                                            <TextBox x:Name="ProxyPasswordVisibleTextBox" Height="32" Style="{StaticResource FlatTextBox}" Padding="8,4,28,4" Visibility="Collapsed" VerticalContentAlignment="Center"/>
                                            <Button Style="{StaticResource FlatActionButton}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" Margin="0,0,4,0" Click="ToggleProxyPassword_Click" ToolTip="{services:Loc settings.proxyPasswordTooltip}">
                                                <controls:LucideIcon x:Name="EyeIcon" Kind="eye" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Uji Koneksi Proxy Card -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TestProxyBtn" Style="{StaticResource PrimaryBlueButton}" Height="34" Padding="16,0" Click="TestProxy_Click">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="refresh-cw" Width="13" Height="13" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="{services:Loc settings.proxyTestBtn}" Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Feedback Badge -->
                                    <Border x:Name="ProxyTestResultBadge" Grid.Column="1" Background="#2610B981" BorderBrush="#6610B981" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Left" Margin="12,0,0,0" Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon x:Name="ProxyTestIcon" Kind="check" Width="12" Height="12" Foreground="{StaticResource AccentEmeraldBrush}" Margin="0,0,6,0"/>
                                            <TextBlock x:Name="ProxyTestResultText" Text="{services:Loc settings.proxySuccess}" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Tip Callout -->
                                <Border Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:LucideIcon Kind="info" Width="15" Height="15" Foreground="{StaticResource AccentCyanBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{services:Loc settings.proxyTip}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- 4: Footer Action Bar (Stitch Clean Dark 1:1) -->
            <Border Grid.Row="4" Background="{StaticResource SurfaceLowestBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <!-- Reset Defaults (Left) -->
                    <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="ResetDefaults_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="rotate-ccw" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{services:Loc settings.resetDefault}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Cancel and Save Settings (Right) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- Batal -->
                        <Button Style="{StaticResource FlatActionButton}" Height="34" Padding="18,0" Margin="0,0,10,0" Click="Cancel_Click">
                            <TextBlock Text="{services:Loc common.cancel}" FontSize="12"/>
                        </Button>

                        <!-- Simpan Pengaturan -->
                        <Button Style="{StaticResource PrimaryBlueButton}" Height="34" Padding="18,0" Click="Ok_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:LucideIcon Kind="check" Width="14" Height="14" Foreground="White" Margin="0,0,7,0"/>
                                <TextBlock Text="{services:Loc settings.saveSettings}" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
