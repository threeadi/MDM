<Window x:Class="Mdm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mdm.ViewModels"
        xmlns:controls="clr-namespace:Mdm.Controls"
        xmlns:services="clr-namespace:Mdm.Services"
        mc:Ignorable="d"
        Title="MDM - Modern Download Manager (.NET 10 Native)" 
        Icon="pack://application:,,,/Mdm;component/Assets/app.ico"
        Height="720" Width="1160"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Background="{StaticResource CanvasBrush}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Mdm;component/Styles/AppTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Sidebar Category & Screen Icon Style (Active turns vibrant Electric Blue #3B82F6) -->
            <Style x:Key="SidebarCategoryIconStyle" TargetType="controls:LucideIcon">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                        <Setter Property="Foreground" Value="#CBD5E1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource CanvasBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Setter Property="Margin" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="8"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <!-- 0: Tier 1 Titlebar & Quick Search -->
            <RowDefinition Height="40"/>
            <!-- 1: Tier 2 Operational Toolbar -->
            <RowDefinition Height="44"/>
            <!-- 2: Top Separator -->
            <RowDefinition Height="1"/>
            <!-- 3: Main Workspace (Sidebar + Views) -->
            <RowDefinition Height="*"/>
            <!-- 4: Bottom Separator -->
            <RowDefinition Height="1"/>
            <!-- 5: Telemetry Footer -->
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- TIER 1: WINDOW HEADER, LOGO & LIVE TELEMETRY BADGE       -->
        <!-- ========================================================= -->
        <Border Grid.Row="0" Background="#11141A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo (MDM Cloud Logo) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Mdm;component/Assets/app.png" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="MDM" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="#1C2028" BorderBrush="#262B35" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                        <TextBlock Text="v4.2 PRO" FontSize="9" FontWeight="Medium" Foreground="#8B949E"/>
                    </Border>
                </StackPanel>

                <!-- Center Quick Search (Clean Dark Matte) -->
                <Grid Grid.Column="1" HorizontalAlignment="Center" Width="380" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBox Style="{StaticResource FlatTextBox}" 
                             Height="28"
                             Padding="28,4,8,4"
                             Background="#090B0E"
                             BorderBrush="#232834"
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             VerticalContentAlignment="Center"/>
                    <controls:LucideIcon Kind="search" Width="13" Height="13" Foreground="#64748B" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0" IsHitTestVisible="False"/>
                    <TextBlock Text="Cari file, tautan unduhan, atau hash MD5..." Foreground="#475569" FontSize="11" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Right Window Caption Controls (Minimize, Maximize/Restore, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowCaptionButtonStyle}" 
                            Click="TitleBar_Minimize_Click" 
                            ToolTip="Kecilkan (Minimize)">
                        <controls:LucideIcon Kind="minus" Width="12" Height="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource WindowCaptionButtonStyle}" 
                            Click="TitleBar_Maximize_Click" 
                            ToolTip="Perbesar / Pulihkan (Maximize / Restore)">
                        <controls:LucideIcon x:Name="MaximizeIcon" Kind="square" Width="11" Height="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseCaptionButtonStyle}" 
                            Click="TitleBar_Close_Click" 
                            ToolTip="Tutup (Close)">
                        <controls:LucideIcon Kind="x" Width="12" Height="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- TIER 2: IDM OPERATIONAL ACTIONS TOOLBAR                  -->
        <!-- ========================================================= -->
        <Border Grid.Row="1" Background="#14171E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Action Buttons Group -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tambah URL Button -->
                    <Button Style="{StaticResource PrimaryBlueButton}" Height="28" Padding="12,4" Margin="0,0,6,0" Click="AddDownload_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="add_link" Width="13" Height="13" Foreground="White" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Tambah URL" FontSize="11" FontWeight="Medium" Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="16" Background="#232834" Margin="3,0,6,0" VerticalAlignment="Center"/>

                    <!-- Mulai Semua -->
                    <Button Style="{StaticResource FlatActionButton}" Height="28" Padding="10,4" Margin="0,0,5,0" Command="{Binding ResumeAllCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="play" Width="12" Height="12" Foreground="#34D399" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc toolbar.resumeAll}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Jeda Semua -->
                    <Button Style="{StaticResource FlatActionButton}" Height="28" Padding="10,4" Margin="0,0,5,0" Command="{Binding PauseAllCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="pause" Width="12" Height="12" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc toolbar.pauseAll}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Bersihkan Selesai -->
                    <Button Style="{StaticResource FlatActionButton}" Height="28" Padding="10,4" Margin="0,0,5,0" Command="{Binding ClearCompletedCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="clear_all" Width="13" Height="13" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc toolbar.clearCompleted}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="16" Background="#232834" Margin="3,0,6,0" VerticalAlignment="Center"/>

                    <!-- Batasi Kecepatan -->
                    <Button Style="{StaticResource FlatActionButton}" Height="28" Padding="10,4" Margin="0,0,5,0" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="speed" Width="13" Height="13" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Batasi Kecepatan" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Telegram Grabber -->
                    <Button Style="{StaticResource FlatActionButton}" Height="28" Padding="10,4" Margin="0,0,5,0" Command="{Binding SwitchToTelegramCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="send" Width="12" Height="12" Foreground="#3B82F6" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc toolbar.telegramGrabber}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right Settings Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource FlatActionButton}" Height="28" Padding="10,4" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <controls:LucideIcon Kind="settings" Width="13" Height="13" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{services:Loc toolbar.settings}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Separator -->
        <Border Grid.Row="2" Background="{StaticResource BorderBrush}"/>

        <!-- ========================================================= -->
        <!-- 3. MAIN WORKSPACE (Sidebar + Views)                      -->
        <!-- ========================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Category Sidebar -->
                <ColumnDefinition Width="205"/>
                <!-- Vertical Divider -->
                <ColumnDefinition Width="1"/>
                <!-- Main Workspace Viewport -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR (Stitch Clean Dark) ================= -->
            <Border Grid.Column="0" Background="#11141A" Padding="10,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Status Section -->
                        <TextBlock Text="STATUS UNDUHAN" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="8,4,0,6"/>

                        <!-- Semua Unduhan -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="all" IsChecked="{Binding IsAllSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="list_alt" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="{services:Loc sidebar.statusAll}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#11141A" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding AllCount}" Foreground="#8B949E" FontSize="10"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- Sedang Mengunduh -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="downloading" IsChecked="{Binding IsDownloadingSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="downloading" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="{services:Loc sidebar.statusDownloading}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#161A22" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ActiveCount}" Foreground="#CBD5E1" FontSize="10"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- Dijeda -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="paused" IsChecked="{Binding IsPausedSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="pause" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="{services:Loc sidebar.statusPaused}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#161A22" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PausedCount}" Foreground="#8B949E" FontSize="10"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- Selesai -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="completed" IsChecked="{Binding IsCompletedSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="check" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="{services:Loc sidebar.statusCompleted}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#161A22" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding CompletedCount}" Foreground="#8B949E" FontSize="10"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- Sampah / Gagal -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="failed" IsChecked="{Binding IsFailedSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="delete_outline" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="Sampah" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#161A22" CornerRadius="4" Padding="6,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding FailedCount}" Foreground="#8B949E" FontSize="10"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <!-- Divider -->
                        <Border Height="1" Background="#1E2330" Margin="4,8"/>

                        <!-- File Type Categories -->
                        <TextBlock Text="KATEGORI BERKAS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,6"/>

                        <!-- Aplikasi -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="program" IsChecked="{Binding IsProgramSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="apps" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="Aplikasi" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ProgramCount}" Foreground="#6E7681" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Dokumen -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="dokumen" IsChecked="{Binding IsDokumenSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="description" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="Dokumen" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DokumenCount}" Foreground="#6E7681" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Video -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="video" IsChecked="{Binding IsVideoSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="movie" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="Video" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding VideoCount}" Foreground="#6E7681" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Musik -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="musik" IsChecked="{Binding IsMusikSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="music_note" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="Musik" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MusikCount}" Foreground="#6E7681" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Arsip ZIP -->
                        <RadioButton GroupName="CatGroup" Command="{Binding SelectCategoryCommand}" CommandParameter="kompresi" IsChecked="{Binding IsKompresiSelected, Mode=OneWay}" Style="{StaticResource CategoryRadioStyle}" Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="folder_zip" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="Arsip ZIP" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding KompresiCount}" Foreground="#6E7681" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </RadioButton>

                        <!-- Divider -->
                        <Border Height="1" Background="#1E2330" Margin="4,8"/>

                        <!-- Otomasi Section -->
                        <TextBlock Text="OTOMASI" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="8,0,0,6"/>

                        <!-- Antrean & Jadwal -->
                        <Border Background="Transparent" CornerRadius="6" Margin="0,1" Padding="10,6">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="schedule" Width="14" Height="14" Foreground="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Antrean &amp; Jadwal" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Telegram Grabber -->
                        <RadioButton GroupName="CatGroup" 
                                     Command="{Binding SwitchToTelegramCommand}" 
                                     IsChecked="{Binding IsTelegramView, Mode=OneWay}" 
                                     Style="{StaticResource CategoryRadioStyle}" 
                                     Margin="0,1">
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <controls:LucideIcon Kind="send" Style="{StaticResource SidebarCategoryIconStyle}"/>
                                    <TextBlock Text="Telegram Grabber" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Background="#1A2740" BorderBrush="#254A80" BorderThickness="1" CornerRadius="4" Padding="5,1" HorizontalAlignment="Right">
                                    <TextBlock Text="MTProto" Foreground="#60A5FA" FontSize="9" FontWeight="Medium"/>
                                </Border>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Vertical Separator -->
            <Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>

            <!-- ================= RIGHT WORKSPACE ================= -->
            <Grid Grid.Column="2" Background="{StaticResource CanvasBrush}" Margin="12,10,12,6">
                <!-- ========================================================= -->
                <!-- VIEWPORT: ANTREAN UNDUHAN TABLE (When IsDownloadsView)    -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding IsDownloadsView, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header & Filter Bar (Stitch Style) -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Daftar Antrean Berkas" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,8,0"/>
                            <Border Background="#171A22" BorderBrush="#262B35" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FilteredCountText}" FontSize="11" Foreground="#8B949E"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- The 60 FPS Virtualized DataGrid with Sorting and Multi-Select -->
                    <DataGrid Grid.Row="1" 
                              x:Name="DownloadsDataGrid"
                              ItemsSource="{Binding FilteredTasks}"
                              SelectedItem="{Binding SelectedTask}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeRows="False"
                              CanUserSortColumns="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1E2330"
                              Background="{StaticResource SurfaceLowBrush}"
                              BorderThickness="1"
                              BorderBrush="{StaticResource BorderBrush}"
                              RowHeight="44"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectionChanged="DataGrid_SelectionChanged"
                              PreviewKeyDown="DataGrid_PreviewKeyDown"
                              MouseDoubleClick="DataGrid_MouseDoubleClick">

                        <DataGrid.Resources>
                            <!-- Header Style with Stitch Minimal Sort Styling -->
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#11141A"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="FontWeight" Value="Medium"/>
                                <Setter Property="Padding" Value="10,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#232834"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridColumnHeader">
                                            <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                                    <Path x:Name="SortArrow" Grid.Column="1" Margin="6,0,2,0" VerticalAlignment="Center" Fill="{StaticResource AccentCyanBrush}" Visibility="Collapsed"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeaderBorder" Property="Background" Value="#1A1E27"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Ascending">
                                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="SortArrow" Property="Data" Value="M 0 4 L 4 0 L 8 4 Z"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                </Trigger>
                                                <Trigger Property="SortDirection" Value="Descending">
                                                    <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="SortArrow" Property="Data" Value="M 0 0 L 4 4 L 8 0 Z"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Row Style -->
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{StaticResource SurfaceLowBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#171A22"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1E283D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>

                            <!-- Cell Style -->
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>

                        <!-- Context Menu -->
                        <DataGrid.ContextMenu>
                            <ContextMenu Background="{StaticResource SurfaceLowBrush}" BorderBrush="{StaticResource BorderBrush}">
                                <MenuItem Header="{services:Loc table.contextOpenFile}" Command="{Binding OpenFileCommand}" Foreground="{StaticResource TextPrimaryBrush}">
                                    <MenuItem.Icon>
                                        <controls:LucideIcon Kind="folder-open" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{services:Loc table.contextOpenFolder}" Command="{Binding OpenFolderCommand}" Foreground="{StaticResource TextPrimaryBrush}">
                                    <MenuItem.Icon>
                                        <controls:LucideIcon Kind="folder" Width="13" Height="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="{services:Loc table.contextResume}" Command="{Binding ResumeCommand}" Foreground="{StaticResource AccentCyanBrush}">
                                    <MenuItem.Icon>
                                        <controls:LucideIcon Kind="play" Width="12" Height="12" Foreground="#34D399"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{services:Loc table.contextPause}" Command="{Binding PauseCommand}" Foreground="{StaticResource AccentAmberBrush}">
                                    <MenuItem.Icon>
                                        <controls:LucideIcon Kind="pause" Width="12" Height="12" Foreground="#94A3B8"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{services:Loc table.contextRefresh}" Click="ContextMenu_RefreshLink_Click" Foreground="{StaticResource AccentCyanBrush}">
                                    <MenuItem.Icon>
                                        <controls:LucideIcon Kind="refresh-cw" Width="12" Height="12" Foreground="{StaticResource AccentCyanBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="{services:Loc table.contextProperties}" Click="ContextMenu_Properties_Click" Foreground="{StaticResource TextSecondaryBrush}">
                                    <MenuItem.Icon>
                                        <controls:LucideIcon Kind="hash" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="Pilih Semua (Ctrl+A)" Click="ContextMenu_SelectAll_Click" Foreground="{StaticResource TextPrimaryBrush}">
                                    <MenuItem.Icon>
                                        <controls:LucideIcon Kind="check-check" Width="12" Height="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{StaticResource BorderBrush}"/>
                                <MenuItem Header="{services:Loc common.delete}" Command="{Binding DeleteCommand}" Foreground="{StaticResource AccentRoseBrush}">
                                    <MenuItem.Icon>
                                        <controls:LucideIcon Kind="delete_outline" Width="12" Height="12" Foreground="{StaticResource AccentRoseBrush}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- Filename with Boxed Category Icon Badge (Stitch Style) -->
                            <DataGridTemplateColumn Header="{services:Loc table.colName}" Width="2*" MinWidth="260" SortMemberPath="Filename" CanUserSort="True" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel VerticalAlignment="Center">
                                            <!-- Square Box Icon (Stitch Style) -->
                                            <Border DockPanel.Dock="Left" Width="28" Height="28" Background="#1C202A" BorderBrush="#282D3B" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                                                <controls:LucideIcon Kind="{Binding LucideCategoryIcon}" Width="15" Height="15" Foreground="{Binding LucideCategoryColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border DockPanel.Dock="Right" Visibility="{Binding IsTelegram, Converter={StaticResource BoolToVis}}" Background="#1A2740" BorderBrush="#254A80" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <controls:LucideIcon Kind="send" Width="9" Height="9" Foreground="#60A5FA" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding TelegramBadgeText}" FontSize="9" FontWeight="Medium" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Filename}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- Size -->
                            <DataGridTemplateColumn Header="{services:Loc table.colSize}" Width="105" SortMemberPath="TotalBytes" CanUserSort="True" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SizeFormatted}" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Progress Bar + Percent -->
                            <DataGridTemplateColumn Header="{services:Loc table.colProgress}" Width="185" SortMemberPath="Progress" CanUserSort="True" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="48"/>
                                            </Grid.ColumnDefinitions>
                                             <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Style="{StaticResource SharpProgressBar}" Foreground="{Binding StatusBrush}" Tag="{Binding IsDownloading}" Height="6"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Speed -->
                            <DataGridTemplateColumn Header="{services:Loc table.colSpeed}" Width="105" SortMemberPath="SpeedBps" CanUserSort="True" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SpeedFormatted}" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Medium" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ETA -->
                            <DataGridTemplateColumn Header="{services:Loc table.colEta}" Width="85" SortMemberPath="EtaSeconds" CanUserSort="True" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding EtaFormatted}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="{services:Loc table.colStatus}" Width="100" SortMemberPath="Status" CanUserSort="True" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBgBrush}" BorderBrush="{Binding StatusBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1.5" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="Medium"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Action Buttons Column (Aksi - 1:1 with Stitch Main Window) -->
                            <DataGridTemplateColumn Header="Aksi" Width="68" CanUserSort="False" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <!-- Downloading: Pause + Cancel -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}">
                                                <Button Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Jeda Unduhan" Margin="0,0,2,0"
                                                        Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                                <controls:LucideIcon Kind="pause" Width="12" Height="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#1E222D"/>
                                                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Batalkan"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                                <controls:LucideIcon Kind="x" Width="12" Height="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#1E222D"/>
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>

                                            <!-- Paused: Resume + Delete -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}">
                                                <Button Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Lanjutkan Unduhan" Margin="0,0,2,0"
                                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                                <controls:LucideIcon Kind="play" Width="12" Height="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#1E222D"/>
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Hapus dari Antrean"
                                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                                <controls:LucideIcon Kind="delete_outline" Width="12" Height="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#1E222D"/>
                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>

                                            <!-- Completed: Open Folder + More -->
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                                <Button Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Buka Berkas" Margin="0,0,2,0"
                                                        Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                                <controls:LucideIcon Kind="folder-open" Width="12" Height="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#1E222D"/>
                                                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <Button Width="22" Height="22" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Opsi Lanjutan" Click="ContextMenu_Properties_Click">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                                <controls:LucideIcon Kind="more_vert" Width="12" Height="12" Foreground="#8B949E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bd" Property="Background" Value="#1E222D"/>
                                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ========================================================= -->
                <!-- VIEWPORT: DUAL-PANE TELEGRAM WORKSPACE (Matching Stitch 1:1) -->
                <!-- ========================================================= -->
                <Grid Visibility="{Binding IsTelegramView, Converter={StaticResource BoolToVis}}" Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- Column 0: Left Sub-Pane (Channel Explorer & Account Vault, w-80 = ~310px) -->
                        <ColumnDefinition Width="310"/>
                        <!-- Column 1: Spacer gap -->
                        <ColumnDefinition Width="10"/>
                        <!-- Column 2: Right Sub-Pane (Active Channel Media Browser & Table) -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ==================================================== -->
                    <!-- LEFT SUB-PANE: CHANNEL & CHAT EXPLORER              -->
                    <!-- ==================================================== -->
                    <Border Grid.Column="0" Background="#171C24" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Account Card Header -->
                                <RowDefinition Height="Auto"/> <!-- Row 1: Search Channels Input -->
                                <RowDefinition Height="*"/>    <!-- Row 2: Scrollable Channels List -->
                                <RowDefinition Height="Auto"/> <!-- Row 3: Add Channel Footer Button -->
                            </Grid.RowDefinitions>

                            <!-- Row 0: Account Card Header -->
                            <Border Grid.Row="0" Background="#11141A" BorderBrush="#232834" BorderThickness="0,0,0,1" Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Initials Avatar with Online Dot -->
                                    <Grid Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#263B82F6" BorderBrush="#4D3B82F6" BorderThickness="1">
                                            <TextBlock Text="{Binding TelegramAccountInitials, FallbackValue='AS'}" Foreground="#60A5FA" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Ellipse Width="10" Height="10" Fill="#10B981" Stroke="#11141A" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2"/>
                                    </Grid>

                                    <!-- Name & Handle Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TelegramAuthStatus.DisplayName, FallbackValue='ASDAD'}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="120" Margin="0,0,6,0"/>
                                            <Border Background="#263B82F6" BorderBrush="#4D3B82F6" BorderThickness="1" CornerRadius="3" Padding="4,1">
                                                <TextBlock Text="MTProto" Foreground="#60A5FA" FontSize="9" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding TelegramAccountDisplay, FallbackValue='@repusid • Terhubung'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxWidth="150"/>
                                    </StackPanel>

                                    <!-- Switch Account Button (Stitch 1:1) -->
                                    <Button Grid.Column="2" Click="TelegramGrabber_Click" Width="28" Height="28" Padding="0" ToolTip="Ganti Profil Akun" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                                                    <controls:LucideIcon x:Name="ic" Kind="switch_account" Width="15" Height="15" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#1E2430"/>
                                                        <Setter TargetName="ic" Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#252D3D"/>
                                                        <Setter TargetName="ic" Property="Foreground" Value="#93C5FD"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Row 1: Search Channels Input -->
                            <Border Grid.Row="1" Background="#171C24" BorderBrush="#232834" BorderThickness="0,0,0,1" Padding="8">
                                <Border Background="#11141A" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Height="30" Padding="8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <controls:LucideIcon Kind="search" Width="13" Height="13" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,7,0"/>

                                        <TextBox Grid.Column="1" 
                                                 Text="{Binding TelegramSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="Transparent" BorderThickness="0" 
                                                 Foreground="#E2E8F0" FontSize="11" 
                                                 VerticalContentAlignment="Center" 
                                                 CaretBrush="#3B82F6"/>

                                        <TextBlock Grid.Column="1" 
                                                   Text="Cari percakapan, kanal, grup..." 
                                                   Foreground="#64748B" FontSize="11" 
                                                   VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0,0,0"
                                                   Visibility="{Binding IsTelegramSearchEmpty, Converter={StaticResource BoolToVis}}"/>

                                        <Button Grid.Column="2" 
                                                Command="{Binding ClearTelegramSearchCommand}" 
                                                Visibility="{Binding HasTelegramSearchQuery, Converter={StaticResource BoolToVis}}" 
                                                Width="16" Height="16" Padding="0" 
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Hapus pencarian">
                                            <controls:LucideIcon Kind="x" Width="10" Height="10" Foreground="#94A3B8"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Row 2: Scrollable Channels List -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                                <StackPanel>
                                    <TextBlock Text="Tidak ada saluran yang cocok" FontSize="11" Foreground="#64748B" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,20,0,0" 
                                               Visibility="{Binding HasNoFilteredTelegramChannels, Converter={StaticResource BoolToVis}}"/>

                                    <ItemsControl ItemsSource="{Binding FilteredTelegramChannels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Command="{Binding DataContext.SelectTelegramChannelCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource TelegramChannelCardButtonStyle}" 
                                                        HorizontalContentAlignment="Stretch" 
                                                        Margin="0,0,0,1">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Top Row: Icon + Title + Type Badge -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icon -->
                                                            <Border Width="24" Height="24" CornerRadius="4" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#1E2430"/>
                                                                        <Setter Property="BorderBrush" Value="#2D3748"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="#263B82F6"/>
                                                                                <Setter Property="BorderBrush" Value="#4D3B82F6"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <controls:LucideIcon Kind="{Binding ChatIconKind}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <controls:LucideIcon.Style>
                                                                        <Style TargetType="controls:LucideIcon">
                                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </controls:LucideIcon.Style>
                                                                </controls:LucideIcon>
                                                            </Border>

                                                            <!-- Title -->
                                                            <TextBlock Grid.Column="1" Text="{Binding FormattedTitle}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#E2E8F0"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <!-- Type Badge -->
                                                            <Border Grid.Column="2" BorderThickness="1" CornerRadius="3" Padding="6,1" VerticalAlignment="Center">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#11141A"/>
                                                                        <Setter Property="BorderBrush" Value="#232834"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Background" Value="#1A3B82F6"/>
                                                                                <Setter Property="BorderBrush" Value="#333B82F6"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding ChatTypeBadge}" FontSize="9.5" FontWeight="Medium">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                    <Setter Property="Foreground" Value="#60A5FA"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Bottom Row: Username + Media Count -->
                                                        <Grid Grid.Row="1" Margin="32,3,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding FormattedUsername}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding MediaCountText}" FontSize="11" FontWeight="SemiBold" Foreground="#60A5FA"/>
                                                        </Grid>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Row 3: Add Channel Footer Button -->
                            <Border Grid.Row="3" Background="#11141A" BorderBrush="#232834" BorderThickness="0,1,0,0" Padding="8">
                                <Button Command="{Binding AddTelegramChannelCommand}" Click="TelegramGrabber_Click" Style="{StaticResource SecondaryGlassButton}" Height="30" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <controls:LucideIcon Kind="plus" Width="13" Height="13" Foreground="#CBD5E1" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Tambah Kanal" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- ==================================================== -->
                    <!-- RIGHT SUB-PANE: MEDIA BROWSER & DATA GRID           -->
                    <!-- ==================================================== -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Row 0: Active Channel Header -->
                            <RowDefinition Height="Auto"/> <!-- Row 1: Filter Chips & Sort -->
                            <RowDefinition Height="*"/>    <!-- Row 2: Media Data Table Container -->
                            <RowDefinition Height="Auto"/> <!-- Row 3: Action Dock -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Active Channel Header Bar -->
                        <Border Grid.Row="0" Background="#171C24" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Movie/Channel Icon + Title + Username on ONE row -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="34" Height="34" Background="#263B82F6" BorderBrush="#4D3B82F6" BorderThickness="1" CornerRadius="6" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <controls:LucideIcon Kind="video" Width="16" Height="16" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveTelegramChannelTitle}" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ActiveTelegramChannelUsername}" FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Right: Blue Sinkronkan Button -->
                                <Button Grid.Column="1" Command="{Binding SyncCurrentTelegramChannelCommand}" Style="{StaticResource PrimaryBlueButton}" Padding="12,6" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:LucideIcon Kind="refresh-cw" Width="14" Height="14" Foreground="#FFFFFF" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Sinkronkan" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Row 1: Filter Chips & Status Tabs Bar -->
                        <Border Grid.Row="1" Background="#171C24" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Media Type Chips -->
                                    <ColumnDefinition Width="Auto"/> <!-- Divider -->
                                    <ColumnDefinition Width="*"/>    <!-- Status Tabs -->
                                    <ColumnDefinition Width="Auto"/> <!-- Sort Dropdown -->
                                </Grid.ColumnDefinitions>

                                <!-- Col 0: Media Type Chips -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource StitchFilterChipButton}" Command="{Binding SetTelegramFilterCommand}" CommandParameter="all" Tag="{Binding IsTgFilterAll}" Content="Semua" Margin="0,0,3,0"/>
                                    <Button Style="{StaticResource StitchFilterChipButton}" Command="{Binding SetTelegramFilterCommand}" CommandParameter="video" Tag="{Binding IsTgFilterVideo}" Content="Video" Margin="0,0,3,0"/>
                                    <Button Style="{StaticResource StitchFilterChipButton}" Command="{Binding SetTelegramFilterCommand}" CommandParameter="document" Tag="{Binding IsTgFilterDoc}" Content="Dokumen" Margin="0,0,3,0"/>
                                    <Button Style="{StaticResource StitchFilterChipButton}" Command="{Binding SetTelegramFilterCommand}" CommandParameter="audio" Tag="{Binding IsTgFilterAudio}" Content="Musik" Margin="0,0,3,0"/>
                                    <Button Style="{StaticResource StitchFilterChipButton}" Command="{Binding SetTelegramFilterCommand}" CommandParameter="photo" Tag="{Binding IsTgFilterPhoto}" Content="Foto"/>
                                </StackPanel>

                                <!-- Col 1: Vertical Divider -->
                                <Border Grid.Column="1" Width="1" Height="14" Background="#232834" Margin="8,0"/>

                                <!-- Col 2: Status Unduhan Tabs Container -->
                                <Border Grid.Column="2" HorizontalAlignment="Left" Background="#11141A" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Semua -->
                                        <Button Style="{StaticResource StitchStatusTabButton}" Command="{Binding SetTelegramStatusFilterCommand}" CommandParameter="all" Tag="{Binding IsTgStatusAll}" Margin="0,0,2,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Semua" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <Border Background="#33FFFFFF" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TelegramMediaCount, Mode=OneWay}" FontSize="10" FontWeight="Medium" Foreground="#FFFFFF"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <!-- Belum Diunduh -->
                                        <Button Style="{StaticResource StitchStatusTabButton}" Command="{Binding SetTelegramStatusFilterCommand}" CommandParameter="uncompleted" Tag="{Binding IsTgStatusUncompleted}" Margin="0,0,2,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Belum Diunduh" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <Border Background="#1E2430" BorderBrush="#232834" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TelegramUncompletedCount, Mode=OneWay}" FontSize="10" FontWeight="Medium" Foreground="#CBD5E1"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>

                                        <!-- Sudah Diunduh -->
                                        <Button Style="{StaticResource StitchStatusTabButton}" Command="{Binding SetTelegramStatusFilterCommand}" CommandParameter="completed" Tag="{Binding IsTgStatusCompleted}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Sudah Diunduh" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                <Border Background="#1E2430" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TelegramCompletedCount, Mode=OneWay}" FontSize="10" FontWeight="Medium" Foreground="#10B981"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!-- Col 3: Sort Dropdown -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <controls:LucideIcon Kind="list-filter" Width="13" Height="13" Foreground="#94A3B8" Margin="0,0,5,0"/>
                                    <ComboBox ItemsSource="{Binding TelegramSortOptions}" SelectedItem="{Binding TelegramSortOption}" Width="105" Height="26" VerticalAlignment="Center" Style="{StaticResource DarkComboBox}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 2: Media Data Table Container -->
                        <Border Grid.Row="2" Background="#171C24" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Table Quick Bar -->
                                    <RowDefinition Height="Auto"/> <!-- Table Header -->
                                    <RowDefinition Height="*"/>    <!-- Table Rows ScrollViewer -->
                                </Grid.RowDefinitions>

                                <!-- Table Quick Bar -->
                                <Border Grid.Row="0" Background="#11141A" BorderBrush="#232834" BorderThickness="0,0,0,1" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Selection Controls -->
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding IsAllUncompletedTelegramSelected, Mode=OneWay}" Command="{Binding SelectOnlyUncompletedTelegramCommand}" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="Pilih Belum Diunduh" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                            </CheckBox>

                                            <!-- Divider -->
                                            <Border Width="1" Height="14" Background="#232834" Margin="10,0"/>

                                            <!-- Selected Telemetry -->
                                            <TextBlock Text="{Binding TelegramSelectedCount}" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text=" Berkas Terpilih" Foreground="#60A5FA" FontWeight="SemiBold" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="•" Foreground="#64748B" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Total Ukuran: " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TelegramSelectedSizeText}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Right Display Telemetry -->
                                        <TextBlock Grid.Column="2" Text="{Binding TelegramDisplayTelemetryText, FallbackValue='Menampilkan 4 dari 1204 berkas (2 diunduh)'}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Table Header -->
                                <Border Grid.Row="1" Background="#0D1117" BorderBrush="#232834" BorderThickness="0,0,0,1" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="75"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="NAMA BERKAS" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" Margin="32,0,0,0"/>
                                        <TextBlock Grid.Column="1" Text="UKURAN" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Column="2" Text="TANGGAL" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="AKSI" FontSize="11" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Table Content Grid (Virtualized ListBox + Bottom Status Strip) -->
                                <Grid Grid.Row="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Empty Media State -->
                                    <Border Grid.Row="0" Visibility="{Binding HasNoTelegramMedia, Converter={StaticResource BoolToVis}}" Padding="32,48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border Width="48" Height="48" Background="#11141A" CornerRadius="24" Margin="0,0,0,12" HorizontalAlignment="Center">
                                                <controls:LucideIcon Kind="send" Width="20" Height="20" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Belum ada berkas media dipindai" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Pilih saluran di panel kiri atau klik 'Sinkronkan' untuk memindai pesan." FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Virtualized ListBox: RAM-Friendly (Only instantiates visible rows) -->
                                    <ListBox x:Name="TelegramMediaListBox" 
                                             Grid.Row="0"
                                             Visibility="{Binding HasTelegramMedia, Converter={StaticResource BoolToVis}}"
                                             ItemsSource="{Binding DisplayedTelegramMedia}"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             VirtualizingPanel.ScrollUnit="Pixel"
                                             ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.ScrollChanged="TelegramMediaListBox_ScrollChanged"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             ItemContainerStyle="{StaticResource TelegramMediaListBoxItemStyle}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#232834" BorderThickness="0,0,0,1" Padding="12,7">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Background" Value="#121D30"/>
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Background" Value="#1E2430"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="100"/>
                                                            <ColumnDefinition Width="140"/>
                                                            <ColumnDefinition Width="75"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Col 0: Checkbox + Icon + Filename + Inline Status Badge -->
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                                <ColumnDefinition Width="Auto" MaxWidth="300"/> <!-- Filename -->
                                                                <ColumnDefinition Width="Auto"/> <!-- Status Badge -->
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                            <!-- Media Icon in Container -->
                                                            <Border Grid.Column="1" Width="24" Height="24" CornerRadius="4" Background="{Binding LucideMediaTypeBg}" BorderBrush="{Binding LucideMediaTypeBorder}" BorderThickness="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                <controls:LucideIcon Kind="{Binding LucideMediaTypeIcon}" Width="13" Height="13" Foreground="{Binding LucideMediaTypeColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>

                                                            <!-- Filename -->
                                                            <TextBlock Grid.Column="2" Text="{Binding Filename}" Foreground="#F1F5F9" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>

                                                            <!-- Status: Selesai -->
                                                            <Border Grid.Column="3" Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" Background="#1A10B981" BorderBrush="#4D10B981" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <controls:LucideIcon Kind="check" Width="11" Height="11" Foreground="#10B981" Margin="0,0,3,0"/>
                                                                    <TextBlock Text="Selesai" Foreground="#10B981" FontSize="10" FontWeight="Medium"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Status: Belum Ada -->
                                                            <Border Grid.Column="3" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}" Background="#11141A" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center">
                                                                <TextBlock Text="Belum Ada" Foreground="#94A3B8" FontSize="10" FontWeight="Medium"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Col 1: Ukuran -->
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" Foreground="#E2E8F0" FontWeight="Medium" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>

                                                        <!-- Col 2: Tanggal -->
                                                        <TextBlock Grid.Column="2" Text="{Binding DateFormatted}" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                                        <!-- Col 3: Aksi Button -->
                                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                            <!-- Buka Button (Completed) -->
                                                            <Button Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}" 
                                                                    Command="{Binding DataContext.OpenFileTelegramCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                    CommandParameter="{Binding}" 
                                                                    Style="{StaticResource TableBukaButton}" Content="Buka"/>

                                                            <!-- Unduh Button (Not Completed) - Icon Only -->
                                                            <Button Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}" 
                                                                    Command="{Binding DataContext.DownloadSingleTelegramItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                    CommandParameter="{Binding}" 
                                                                    ToolTip="Unduh Berkas"
                                                                    Style="{StaticResource TableUnduhButton}">
                                                                <controls:LucideIcon Kind="download" Width="13" Height="13" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <!-- Bottom Pagination & Auto-Fetch Strip -->
                                    <Border Grid.Row="1" Visibility="{Binding HasTelegramMedia, Converter={StaticResource BoolToVis}}" 
                                            Background="#0D1117" BorderBrush="#232834" BorderThickness="0,1,0,0" Padding="12,8">
                                        <Grid>
                                            <!-- Auto-Fetch Active State -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                                                        Visibility="{Binding IsAutoFetchingAllTelegram, Converter={StaticResource BoolToVis}}">
                                                <controls:LucideIcon Kind="refresh-cw" Width="14" Height="14" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding AutoFetchStatusText, FallbackValue='Memuat seluruh media...'}" FontSize="11.5" FontWeight="Medium" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <Button Command="{Binding CancelAutoFetchTelegramCommand}" Style="{StaticResource SecondaryGlassButton}" Padding="10,3" Cursor="Hand">
                                                    <TextBlock Text="Batal" FontSize="11" Foreground="#EF4444"/>
                                                </Button>
                                            </StackPanel>

                                            <!-- Scanning Indicator (Single Batch) -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" 
                                                        Margin="0,2">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding TelegramIsScanning}" Value="True"/>
                                                                    <Condition Binding="{Binding IsAutoFetchingAllTelegram}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <controls:LucideIcon Kind="refresh-cw" Width="14" Height="14" Foreground="#60A5FA" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Memindai media selanjutnya dari Telegram..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Ready State: Load More & Auto-Fetch Buttons -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TelegramIsScanning}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAutoFetchingAllTelegram}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasMoreTelegramMedia}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>

                                                <!-- Button 1: Load Next Batch -->
                                                <Button Command="{Binding ScanTelegramCommand}" 
                                                        CommandParameter="loadMore" 
                                                        Style="{StaticResource SecondaryGlassButton}"
                                                        Padding="14,5" Margin="0,0,8,0" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <controls:LucideIcon Kind="chevron-down" Width="13" Height="13" Foreground="#60A5FA" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Muat Lebih Banyak" FontSize="11" FontWeight="Medium" Foreground="#CBD5E1" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Button 2: Auto-Fetch All Media -->
                                                <Button Command="{Binding AutoFetchAllTelegramCommand}" 
                                                        Style="{StaticResource SecondaryGlassButton}"
                                                        ToolTip="Otomatis memuat seluruh halaman media secara berurutan ke dalam tabel"
                                                        Padding="14,5" Cursor="Hand">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <controls:LucideIcon Kind="chevrons-down" Width="13" Height="13" Foreground="#38BDF8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Muat Semua Media Otomatis" FontSize="11" FontWeight="Medium" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <!-- End of Media Notice -->
                                            <TextBlock Text="Semua media dalam obrolan/kanal ini telah dimuat" 
                                                       FontSize="11" FontStyle="Italic" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding HasMoreTelegramMedia}" Value="False"/>
                                                                    <Condition Binding="{Binding TelegramIsScanning}" Value="False"/>
                                                                    <Condition Binding="{Binding IsAutoFetchingAllTelegram}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Row 3: Sticky Bottom Action Dock -->
                        <Border Grid.Row="3" Background="#171C24" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Unduh Terpilih + Unduh Semua Belum Ada + Streaming Progress -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Unduh Terpilih Button -->
                                    <Button Command="{Binding DownloadSelectedTelegramCommand}" Style="{StaticResource PrimaryBlueButton}" Padding="16,7">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="download" Width="15" Height="15" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                            <TextBlock Text="Unduh Terpilih" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Unduh Semua Belum Ada (Direct-to-Download Queue Streaming) -->
                                    <Button Command="{Binding DownloadAllUncompletedTelegramCommand}" 
                                            Style="{StaticResource TelegramBatchDownloadButton}" 
                                            Visibility="{Binding IsNotBatchQueueingTelegram, Converter={StaticResource BoolToVis}}"
                                            ToolTip="Unduh SEMUA media yang belum ada di saluran ini tanpa harus menggulir (streaming antrean langsung ke unduhan)"
                                            Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="download" Width="14" Height="14" Foreground="#38BDF8" Margin="0,0,6,0"/>
                                            <TextBlock Text="Unduh Semua Belum Ada" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                                        </StackPanel>
                                    </Button>

                                    <!-- Batch Queue Streaming Active Progress Indicator -->
                                    <Border Visibility="{Binding IsBatchQueueingTelegram, Converter={StaticResource BoolToVis}}"
                                            Background="#111827" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <controls:LucideIcon Kind="refresh-cw" Width="13" Height="13" Foreground="#38BDF8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding BatchQueueStatusText}" Foreground="#E2E8F0" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                            <Button Command="{Binding CancelBatchQueueTelegramCommand}" Style="{StaticResource SecondaryGlassButton}" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Cursor="Hand">
                                                <TextBlock Text="Batal" FontSize="10.5" Foreground="#EF4444"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Subtitle next to buttons (when not batch queueing) -->
                                    <TextBlock Visibility="{Binding IsNotBatchQueueingTelegram, Converter={StaticResource BoolToVis}}"
                                               Text="{Binding TelegramUncompletedSelectedText, FallbackValue='2 berkas belum diunduh dipilih'}" 
                                               Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <!-- Right: Save Dir Picker in Pill Container -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Simpan di: " Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Background="#11141A" BorderBrush="#232834" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding EffectiveTelegramTargetDir}" Foreground="#E2E8F0" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                    </Border>
                                    <Button Command="{Binding ChangeTelegramDirCommand}" Style="{StaticResource SecondaryGlassButton}" Width="28" Height="28" Padding="0" VerticalAlignment="Center" ToolTip="Ubah Direktori">
                                        <controls:LucideIcon Kind="folder-open" Width="14" Height="14" Foreground="#94A3B8"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- 4. Bottom Separator -->
        <Border Grid.Row="4" Background="{StaticResource BorderBrush}"/>

        <!-- ========================================================= -->
        <!-- 5. BOTTOM STATUS TELEMETRY BAR                           -->
        <!-- ========================================================= -->
        <Border Grid.Row="5" Background="#0C0E12" Padding="16,0" Height="28">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Telemetry: Speed & Data Usage -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:LucideIcon Kind="download" Width="13" Height="13" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{services:Loc statusbar.speed}" Foreground="#94A3B8" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding GlobalSpeedText}" Foreground="#E2E5EB" FontWeight="Medium" FontSize="11" VerticalAlignment="Center"/>

                    <Border Width="1" Height="12" Background="{StaticResource BorderBrush}" Margin="12,0" VerticalAlignment="Center"/>

                    <controls:LucideIcon Kind="data_usage" Width="13" Height="13" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{services:Loc statusbar.quotaUsage}" Foreground="#94A3B8" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalVolumeText}" Foreground="#E2E5EB" FontWeight="Medium" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right Telemetry: Extension & SSL/TLS Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{services:Loc statusbar.extensionConnected}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>

                    <Border Width="1" Height="12" Background="{StaticResource BorderBrush}" Margin="12,0" VerticalAlignment="Center"/>

                    <controls:LucideIcon Kind="lock" Width="12" Height="12" Foreground="#94A3B8" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{services:Loc statusbar.sslVerified}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
