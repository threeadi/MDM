<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Design System Brushes (Clean Dark Matte - Stitch Project 8619236184062954585) -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#0B0D11"/>
    <SolidColorBrush x:Key="SurfaceLowestBrush" Color="#0B0D11"/>
    <SolidColorBrush x:Key="SurfaceLowBrush" Color="#14171D"/>
    <SolidColorBrush x:Key="SurfaceMediumBrush" Color="#191D26"/>
    <SolidColorBrush x:Key="SurfaceHighBrush" Color="#222733"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1E232D"/>
    <SolidColorBrush x:Key="SurfaceSelectedBrush" Color="#222733"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#282C37"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#21252F"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#171A22"/>
    
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="AccentSecondaryCyanBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentEmeraldBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="AccentAmberBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="AccentRoseBrush" Color="#D07B7B"/>
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E"/>
    <SolidColorBrush x:Key="TextHighlightBrush" Color="#93C5FD"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6E7681"/>

    <!-- Design System Typography (Strictly Sans-Serif - ABSOLUTELY NO MONOSPACE) -->
    <FontFamily x:Key="AppFontSans">pack://application:,,,/Fonts/#Plus Jakarta Sans, Inter, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="AppFontMono">pack://application:,,,/Fonts/#Plus Jakarta Sans, Inter, Segoe UI, sans-serif</FontFamily>

    <!-- Global Typography Style -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFontSans}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontSans}"/>
    </Style>

    <Style TargetType="Control">
        <Setter Property="FontFamily" Value="{StaticResource AppFontSans}"/>
    </Style>

    <!-- Flat Action Button Style (Stitch Clean Dark) -->
    <Style x:Key="FlatActionButton" TargetType="Button">
        <Setter Property="Background" Value="#1E222B"/>
        <Setter Property="Foreground" Value="#DEE2EE"/>
        <Setter Property="BorderBrush" Value="#2C3240"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#252A35"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                            <Setter Property="BorderBrush" Value="#363E4E"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#171A22"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Channel Row Button Style (Left-Aligned, Clean Transparent with Subtle Hover) -->
    <Style x:Key="SidebarChannelRowButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#C2C6D6"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#171C24"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#252A35"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#11141A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dual-Pane Telegram Channel Card Button Style (Matching Stitch 1:1) -->
    <Style x:Key="TelegramChannelCardButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#94A3B8"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0,4,4,0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#172236"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#3B82F6"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="bd" Property="Background" Value="#1E2430"/>
                            <Setter Property="Foreground" Value="#E2E8F0"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary Blue Button (Matching Stitch bg-blue-600 #2563EB) -->
    <Style x:Key="PrimaryBlueButton" TargetType="Button">
        <Setter Property="Background" Value="#2563EB"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#3B82F6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#60A5FA"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1E40AF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

