    <!-- Flat Dark TextBox Style -->
    <Style x:Key="FlatTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="#090E16"/>
        <Setter Property="Foreground" Value="#DEE2EE"/>
        <Setter Property="BorderBrush" Value="#252A33"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
